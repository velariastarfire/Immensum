<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp 
  xmlns="http://microsoft.com" 
  xmlns:xsi="http://w3.org" 
  xmlns:bt="http://microsoft.com" 
  xmlns:ov="http://microsoft.com" 
  xsi:type="TaskPaneApp">

  
  <Id>d3b07384-d113-433a-86b3-96b052d92cd1</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Recursive Roots</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Immensum Engine"/>
  <Description DefaultValue="High-precision calculations for large integers exceeding platform limits."/>
  
  <!-- Verified Secure Domain Asset Routing -->
  <IconUrl DefaultValue="https://immensum.app"/>
  <SupportUrl DefaultValue="https://immensum.app"/>

  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://immensum.app"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <!-- Absolute Requirements for Sideloading Validation Compliance -->
  <VersionOverrides xmlns="http://microsoft.com" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Taskpane.Url"/>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://immensum.app"/>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://immensum.app"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Immensum Engine"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Your high-precision mathematical execution engine is active."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
